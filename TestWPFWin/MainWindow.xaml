<Window x:Class="TestWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestWPF"
        xmlns:local1="clr-namespace:MaintainDataClassLibrary;assembly=MaintainDataClassLibrary"
        mc:Ignorable="d"
        Title="设备维护数据统计" Height="700" Width="1100" WindowStartupLocation="CenterScreen"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--顶部工具条：打开维护窗口（手动录入维修/协助/暂停）+ 设备状态模拟入口-->
        <Border Grid.Row="0" Background="#F5F8FC" BorderBrush="#E3E9F0" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="维护操作" Width="110" Height="32" Click="OpenMaintainWindow_Click"/>
                <Separator Style="{x:Null}" Width="1" Background="#DCE3EC" Margin="12,4"/>
                <TextBlock Text="设备状态模拟：" VerticalAlignment="Center" Foreground="#5A6B7B" Margin="0,0,8,0"/>
                <Button Content="自动运行" Width="80" Height="32" Margin="0,0,6,0" Click="SimulateStartRun_Click"/>
                <Button Content="开始维修" Width="80" Height="32" Margin="0,0,6,0" Click="SimulateRepairStart_Click"/>
                <Button Content="结束维修" Width="80" Height="32" Margin="0,0,6,0" Click="SimulateRepairEnd_Click"/>
                <Button Content="开始协助" Width="80" Height="32" Margin="0,0,6,0" Click="SimulateAssistanceStart_Click"/>
                <Button Content="结束协助" Width="80" Height="32" Margin="0,0,6,0" Click="SimulateAssistanceEnd_Click"/>
                <Button Content="暂停/停机" Width="80" Height="32" Margin="0,0,6,0" Click="SimulatePause_Click"/>
                <Button Content="重新生成演示数据" Width="130" Height="32" Margin="12,0,0,0" Click="SeedDemoData_Click"/>
            </StackPanel>
        </Border>

        <!--维护数据统计页面-->
        <local1:MaintainDataStatistics x:Name="StatisticsPage" Grid.Row="1"/>
    </Grid>
</Window>
