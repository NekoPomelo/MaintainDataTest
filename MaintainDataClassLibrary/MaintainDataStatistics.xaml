<UserControl x:Class="MaintainDataClassLibrary.MaintainDataStatistics"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MaintainDataClassLibrary"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000" Background="White">
    <UserControl.Resources>
        <!--指标卡片的边框样式-->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#F7F9FC"/>
            <Setter Property="BorderBrush" Value="#DCE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#5A6B7B"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8899A6"/>
        </Style>
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#33475B"/>
        </Style>
        <!--内容选项按钮：选中时高亮-->
        <Style x:Key="ContentToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#F0F3F7"/>
            <Setter Property="Foreground" Value="#33475B"/>
            <Setter Property="BorderBrush" Value="#C9D4E0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E1E9F3"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F80ED"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F80ED"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:BoolToBrushConverter x:Key="BoolToBrush" TrueBrush="#1E9E63" FalseBrush="#D64545"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--1.顶部三项指标：MTBF / MTBA / MTTA-->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="MTBF 平均故障间隔时间" Style="{StaticResource CardTitle}"/>
                    <TextBlock Grid.Row="1" Text="{Binding MTBFText}" Style="{StaticResource CardValue}"
                               Foreground="{Binding MTBFGood, Converter={StaticResource BoolToBrush}}"/>
                    <TextBlock Grid.Row="2" Text="{Binding MTBFThreshold}" Style="{StaticResource CardHint}"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="MTBA 平均间隔辅助时间" Style="{StaticResource CardTitle}"/>
                    <TextBlock Grid.Row="1" Text="{Binding MTBAText}" Style="{StaticResource CardValue}"
                               Foreground="{Binding MTBAGood, Converter={StaticResource BoolToBrush}}"/>
                    <TextBlock Grid.Row="2" Text="{Binding MTBAThreshold}" Style="{StaticResource CardHint}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="MTTA 平均协助时间" Style="{StaticResource CardTitle}"/>
                    <TextBlock Grid.Row="1" Text="{Binding MTTAText}" Style="{StaticResource CardValue}"
                               Foreground="{Binding MTTAGood, Converter={StaticResource BoolToBrush}}"/>
                    <TextBlock Grid.Row="2" Text="{Binding MTTAThreshold}" Style="{StaticResource CardHint}"/>
                </Grid>
            </Border>
        </Grid>

        <!--2.时间区间选择按钮 + 内容选项按钮-->
        <Border Grid.Row="1" Background="#FAFBFD" BorderBrush="#E3E9F0" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,12,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="开始时间" Style="{StaticResource ToolbarLabel}"/>
                <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Width="130" Height="30"
                            VerticalContentAlignment="Center"/>
                <TextBlock Text="结束时间" Style="{StaticResource ToolbarLabel}" Margin="14,0,6,0"/>
                <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Width="130" Height="30"
                            VerticalContentAlignment="Center"/>
                <Separator Style="{x:Null}" Width="1" Background="#E0E6EE" Margin="18,2,18,2"/>
                <TextBlock Text="内容选项" Style="{StaticResource ToolbarLabel}"/>
                <ToggleButton Content="MTBF" Style="{StaticResource ContentToggle}"
                              IsChecked="{Binding IsMTBF, Mode=OneWay}"
                              Command="{Binding SelectContentCommand}" CommandParameter="MTBF"/>
                <ToggleButton Content="MTBA" Style="{StaticResource ContentToggle}"
                              IsChecked="{Binding IsMTBA, Mode=OneWay}"
                              Command="{Binding SelectContentCommand}" CommandParameter="MTBA"/>
                <ToggleButton Content="MTTA" Style="{StaticResource ContentToggle}" Margin="0"
                              IsChecked="{Binding IsMTTA, Mode=OneWay}"
                              Command="{Binding SelectContentCommand}" CommandParameter="MTTA"/>
                <Button Content="刷新" Width="60" Height="30" Margin="18,0,0,0"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Border>

        <!--3.柱状图：横坐标为日期，纵坐标为小时(MTTA为分钟)-->
        <Border Grid.Row="2" BorderBrush="#E3E9F0" BorderThickness="1" CornerRadius="6" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,0,0">
                    <TextBlock Text="{Binding ContentText}" FontSize="14" FontWeight="Bold" Foreground="#33475B"/>
                    <TextBlock Text="  按日期统计 · " FontSize="12" Foreground="#8899A6" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding YAxisUnitText}" FontSize="12" Foreground="#8899A6" VerticalAlignment="Bottom"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="12,6,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!--纵坐标刻度-->
                    <Grid Grid.Column="0" Width="60" VerticalAlignment="Top" Height="{Binding ChartBarAreaHeight}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{Binding ChartBarAreaHeight}"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding YAxisTopText}" FontSize="11"
                                       Foreground="#5A6B7B" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="2" Text="{Binding YAxisMiddleText}" FontSize="11"
                                       Foreground="#5A6B7B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Text="{Binding YAxisBottomText}" FontSize="11"
                                       Foreground="#5A6B7B" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding YAxisUnitText}" FontSize="11"
                                   Foreground="#8899A6" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </Grid>

                    <!--绘图区：网格线 + 柱状图-->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Height="{Binding ChartBarAreaHeight}">
                            <!--横向网格线，与纵坐标刻度一一对应-->
                            <Grid Height="{Binding ChartBarAreaHeight}" VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Height="1" Fill="#E7EDF4"/>
                                <Rectangle Grid.Row="2" Height="1" Fill="#E7EDF4"/>
                                <Rectangle Grid.Row="4" Height="1" Fill="#C9D4E0"/>
                            </Grid>

                            <!--数据为空时的提示-->
                            <TextBlock Text="所选区间内暂无统计数据" Foreground="#A9B6C4" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Bars.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!--柱状图主体：一张卡片=一根柱子-->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Padding="0,0,0,0">
                                <ItemsControl ItemsSource="{Binding Bars}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding DataContext.ChartColumnWidth,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  Height="{Binding DataContext.ChartBarAreaHeight,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  ToolTip="{Binding Tip}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <!--柱顶数值-->
                                                <TextBlock Grid.Row="0" Text="{Binding ValueText}" FontSize="10"
                                                           Foreground="#5A6B7B" HorizontalAlignment="Center"/>
                                                <!--柱子-->
                                                <Grid Grid.Row="1" VerticalAlignment="Bottom">
                                                    <Rectangle Width="26" Height="{Binding Height}"
                                                               VerticalAlignment="Bottom"
                                                               Fill="#2F80ED" RadiusX="3" RadiusY="3">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasValue}" Value="False">
                                                                        <Setter Property="Fill" Value="#DCE3EC"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!--横坐标日期-->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Bars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#5A6B7B"
                                                   Width="{Binding DataContext.ChartColumnWidth,
                                                           RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   TextAlignment="Center" Margin="0,4,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!--底部累计信息-->
        <TextBlock Grid.Row="3" Text="{Binding SummaryText}" FontSize="12" Foreground="#8899A6"
                   HorizontalAlignment="Right" Margin="0,6,2,0"/>
    </Grid>
</UserControl>
