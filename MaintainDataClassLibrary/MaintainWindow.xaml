<Window x:Class="MaintainDataClassLibrary.MaintainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MaintainDataClassLibrary"
        mc:Ignorable="d"
        Title="维护操作" Height="auto" Width="400" WindowStyle="None"
        WindowStartupLocation="CenterOwner" Background="White" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button" x:Key="button">
            <Setter Property="Background" Value="#F0F3F7"/>
            <Setter Property="Foreground" Value="#22313F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle Name="Rec" Fill="{TemplateBinding Background}" RadiusX="20" RadiusY="20"
                                       Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                       Stroke="#C9D4E0" StrokeThickness="1"></Rectangle>
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Fill" TargetName="Rec" Value="#E1E9F3"></Setter>
                            </Trigger>
                            <Trigger Property="IsMouseCaptured" Value="True">
                                <Setter Property="Fill" TargetName="Rec" Value="#C7D8EE"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <StackPanel Margin="10,10,10,10" >
            <Button Style="{StaticResource button}" Width="300" Height="60" Margin="10" Visibility="{Binding RepairStartVisibility }" Command="{Binding ButtonClick}" CommandParameter="RepairStart">
                <StackPanel>
                    <Label Content="开始维修" HorizontalAlignment="Center"></Label>
                    <Label Content="由于设备机械故障导致的必须性维修"></Label>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource button}" Width="300" Height="60" Margin="10" Visibility="{Binding RepairEndVisibility }" Command="{Binding ButtonClick}" CommandParameter="RepairEnd">
                <StackPanel>
                    <Label Content="结束维修" HorizontalAlignment="Center"></Label>
                    <Label Content="由于设备机械故障导致的必须性维修"></Label>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource button}" Width="300" Height="60" Margin="10" Visibility="{Binding AssistanceStartVisibility }" Command="{Binding ButtonClick}" CommandParameter="AssistanceStart">
                <StackPanel>
                    <Label Content="开始协助" HorizontalAlignment="Center"></Label>
                    <Label Content="必须由人工干涉处理的协助性异常"></Label>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource button}" Width="300" Height="60" Margin="10" Visibility="{Binding AssistanceEndVisibility }" Command="{Binding ButtonClick}" CommandParameter="AssistanceEnd">
                <StackPanel>
                    <Label Content="结束协助" HorizontalAlignment="Center"></Label>
                    <Label Content="必须由人工干涉处理的协助性异常"></Label>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource button}" Width="300" Height="60" Margin="10" Visibility="{Binding PauseVisibility }" Command="{Binding ButtonClick}" CommandParameter="Pause">
                <StackPanel>
                    <Label Content="临时性暂停\停止" HorizontalAlignment="Center"></Label>
                    <Label Content="设备无异常的临时性暂停或停止"></Label>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource button}" Width="300" Height="60" Margin="10" Visibility="{Binding CancelVisibility }" Command="{Binding ButtonClick}" CommandParameter="Cancel">
                <StackPanel>
                    <Label Content="取消" HorizontalAlignment="Center"></Label>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
